{
  "manifest_version": 3,
  "name": "Yodayo Preset",
  "version": "1.0.0",
  "description": "Save and load Yodayo text-to-image settings (model, spells, prompts, sampler, size...) as presets.",
  "permissions": ["storage", "unlimitedStorage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open / close the Yodayo Preset panel"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Open or close the Yodayo Preset panel"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://yodayo.com/*", "https://*.yodayo.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://yodayo.com/*", "https://*.yodayo.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
